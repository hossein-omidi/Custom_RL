-    """Map physical action to normalized action in [-1, 1]."""
-    u_phys = np.asarray(u_phys, dtype=np.float64).reshape(-1)
-    low = np.asarray(low, dtype=np.float64).reshape(-1)
-    high = np.asarray(high, dtype=np.float64).reshape(-1)
